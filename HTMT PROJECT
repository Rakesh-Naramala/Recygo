3. Database Layer(db.js)
Connects to PostgreSQL, activates PostGIS, creates all tables, seeds standard scrap rates, and sets up a mock seller and buyer so the system is ready to use on startup.

    JavaScript
import pg from 'pg';
import dotenv from 'dotenv';

dotenv.config();

const { Pool } = pg;

export const pool = new Pool({
    connectionString: process.env.DATABASE_URL,
});

export async function initDatabase() {
    const setupSQL = `
    CREATE EXTENSION IF NOT EXISTS postgis;

    CREATE TABLE IF NOT EXISTS users (
      id SERIAL PRIMARY KEY,
      name VARCHAR(100) NOT NULL,
      phone VARCHAR(20) UNIQUE NOT NULL,
      role VARCHAR(20) NOT NULL CHECK (role IN ('seller', 'buyer')),
      location GEOGRAPHY(Point, 4326) NOT NULL,
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );

    CREATE TABLE IF NOT EXISTS categories (
      id SERIAL PRIMARY KEY,
      name VARCHAR(50) UNIQUE NOT NULL,
      standard_price_per_kg NUMERIC(8, 2) NOT NULL
    );

    CREATE TABLE IF NOT EXISTS listings (
      id SERIAL PRIMARY KEY,
      seller_id INT REFERENCES users(id) ON DELETE CASCADE,
      category_id INT REFERENCES categories(id),
      title VARCHAR(150) NOT NULL,
      description TEXT,
      ai_detected_category VARCHAR(50),
      ai_confidence NUMERIC(3, 2),
      estimated_weight NUMERIC(8, 2) NOT NULL,
      asking_price NUMERIC(10, 2),
      location GEOGRAPHY(Point, 4326) NOT NULL,
      landmark TEXT,
      gate_instructions TEXT,
      status VARCHAR(20) DEFAULT 'open' CHECK (status IN ('open', 'matched', 'completed', 'cancelled')),
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );

    CREATE TABLE IF NOT EXISTS orders (
      id SERIAL PRIMARY KEY,
      listing_id INT REFERENCES listings(id) ON DELETE CASCADE,
      buyer_id INT REFERENCES users(id),
      scheduled_pickup TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
      gross_weight NUMERIC(8, 2),
      tare_deduction NUMERIC(8, 2) DEFAULT 0.00,
      actual_weight NUMERIC(8, 2),
      final_amount NUMERIC(10, 2),
      ai_detected_weight NUMERIC(8, 2),
      scale_photo_status VARCHAR(30) DEFAULT 'verified',
      otp_code VARCHAR(6) NOT NULL,
      original_category_id INT REFERENCES categories(id),
      adjusted_category_id INT REFERENCES categories(id),
      category_adjusted_reason TEXT,
      payment_status VARCHAR(20) DEFAULT 'pending' CHECK (payment_status IN ('pending', 'completed')),
      status VARCHAR(20) DEFAULT 'scheduled' CHECK (status IN ('scheduled', 'picked_up', 'cancelled')),
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );

    -- Seed standard categories & prices (INR/kg)
    INSERT INTO categories (name, standard_price_per_kg)
    VALUES 
      ('cardboard', 12.00),
      ('pet-plastic', 18.50),
      ('aluminum-scrap', 110.00),
      ('e-waste', 75.00),
      ('iron-scrap', 28.00)
    ON CONFLICT (name) DO NOTHING;

    -- Seed default demo users if empty
    INSERT INTO users (id, name, phone, role, location)
    VALUES 
      (1, 'Ramesh Kumar (Seller)', '9876543210', 'seller', ST_SetSRID(ST_MakePoint(77.5946, 12.9716), 4326)),
      (2, 'EcoRecycle Hub (Buyer)', '9123456780', 'buyer', ST_SetSRID(ST_MakePoint(77.5900, 12.9700), 4326))
    ON CONFLICT (id) DO NOTHING;
  `;

    await pool.query(setupSQL);
    console.log('PostgreSQL + PostGIS database initialized successfully.');
}
4. Platform AI Service(aiService.js)
Handles both multimodal AI workloads:

Waste item identification & weight estimation for sellers.

Weighing scale OCR inspection with automatic error fallback for buyers at doorstep.

    JavaScript
import { GoogleGenAI, Type } from '@google/genai';
import dotenv from 'dotenv';

dotenv.config();

const ai = new GoogleGenAI();

/**
 * 1. AI Vision: Classify scrap image and auto-fill listing
 */
export async function classifyScrapImage(imageBase64, mimeType = 'image/jpeg') {
    const prompt = `
    Analyze this photo of household or industrial scrap/waste.
    Return the detected category, whether it is recyclable, an estimated weight in kilograms 
    based on visible scale, a cleanliness assessment, a clean short title, and a confidence score between 0.0 and 1.0.
  `;

    try {
        const response = await ai.models.generateContent({
            model: 'gemini-2.5-flash',
            contents: [
                {
                    role: 'user',
                    parts: [
                        { text: prompt },
                        { inlineData: { data: imageBase64, mimeType } },
                    ],
                },
            ],
            config: {
                responseMimeType: 'application/json',
                responseSchema: {
                    type: Type.OBJECT,
                    properties: {
                        category: {
                            type: Type.STRING,
                            description: 'Must match one of: cardboard, pet-plastic, aluminum-scrap, e-waste, iron-scrap, other'
                        },
                        is_recyclable: { type: Type.BOOLEAN },
                        estimated_weight_kg: { type: Type.NUMBER },
                        confidence_score: { type: Type.NUMBER },
                        cleanliness_status: { type: Type.STRING },
                        suggested_title: { type: Type.STRING },
                    },
                    required: ['category', 'is_recyclable', 'estimated_weight_kg', 'confidence_score', 'suggested_title'],
                },
            },
        });

        return JSON.parse(response.text);
    } catch (error) {
        console.error('AI Classification Error:', error.message);
        // Safe mock fallback if API key is not yet set
        return {
            category: 'cardboard',
            is_recyclable: true,
            estimated_weight_kg: 5.0,
            confidence_score: 0.85,
            cleanliness_status: 'dry and bundled',
            suggested_title: 'Corrugated Cardboard Boxes (~5kg)',
        };
    }
}

/**
 * 2. AI OCR: Verify physical weighing scale screen at doorstep
 */
export async function verifyScaleReading(imageBase64, manualGrossWeight) {
    const prompt = `
    Analyze this photo of scrap placed on a weighing scale.
    Read the numeric weight shown on the digital or analog scale display.
    If the display is obscured, analog needle-based, or unreadable due to glare, set is_readable to false.
  `;

    try {
        const response = await ai.models.generateContent({
            model: 'gemini-2.5-flash',
            contents: [
                {
                    role: 'user',
                    parts: [
                        { text: prompt },
                        { inlineData: { data: imageBase64, mimeType: 'image/jpeg' } },
                    ],
                },
            ],
            config: {
                responseMimeType: 'application/json',
                responseSchema: {
                    type: Type.OBJECT,
                    properties: {
                        scale_reading: { type: Type.NUMBER },
                        is_readable: { type: Type.BOOLEAN },
                        display_type: { type: Type.STRING },
                        confidence_score: { type: Type.NUMBER },
                    },
                    required: ['is_readable', 'display_type'],
                },
            },
        });

        const result = JSON.parse(response.text);

        if (result.is_readable && result.scale_reading != null) {
            const difference = Math.abs(result.scale_reading - manualGrossWeight);
            const isMismatched = difference > 0.5;

            return {
                status: isMismatched ? 'disputed' : 'verified',
                ai_weight: result.scale_reading,
                needs_human_audit: isMismatched,
                notes: isMismatched
                    ? `Scale shows ${result.scale_reading}kg but entered ${manualGrossWeight}kg`
                    : 'Matched display reading',
            };
        }

        return {
            status: 'unreadable_fallback',
            ai_weight: null,
            needs_human_audit: true,
            notes: 'Glare/analog scale detected. Proceeded with manual entry and seller OTP.',
        };
    } catch (err) {
        return {
            status: 'unreadable_fallback',
            ai_weight: null,
            needs_human_audit: true,
            notes: 'OCR service offline. Proceeded with manual weight and seller OTP.',
        };
    }
}
5. Unified Express Server(server.js)
Exposes all endpoints for Seller, Buyer, and Platform AI, and serves the interactive frontend from the / public folder.

    JavaScript
import express from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import path from 'path';
import { fileURLToPath } from 'url';
import { pool, initDatabase } from './db.js';
import { classifyScrapImage, verifyScaleReading } from './aiService.js';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
app.use(cors());
app.use(express.json({ limit: '15mb' }));
app.use(express.static(path.join(__dirname, 'public')));

// ---------------------------------------------------------------------
// 1. SYSTEM & AI ENDPOINTS
// ---------------------------------------------------------------------

// Fetch scrap rates
app.get('/api/categories/rates', async (req, res) => {
    try {
        const { rows } = await pool.query('SELECT * FROM categories ORDER BY standard_price_per_kg DESC');
        res.json({ success: true, rates: rows });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Platform AI: Scan Waste Image
app.post('/api/ai/classify', async (req, res) => {
    try {
        const { imageBase64 } = req.body;
        if (!imageBase64) return res.status(400).json({ error: 'imageBase64 required' });

        const cleanBase64 = imageBase64.replace(/^data:image\/\w+;base64,/, '');
        const aiResult = await classifyScrapImage(cleanBase64);

        const catRes = await pool.query('SELECT id, standard_price_per_kg FROM categories WHERE name = $1', [
            aiResult.category,
        ]);

        let categoryId = 1;
        let rate = 12.0;

        if (catRes.rows.length > 0) {
            categoryId = catRes.rows[0].id;
            rate = parseFloat(catRes.rows[0].standard_price_per_kg);
        }

        const estimatedPayout = parseFloat((aiResult.estimated_weight_kg * rate).toFixed(2));

        res.json({
            success: true,
            analysis: aiResult,
            category_id: categoryId,
            rate_per_kg: rate,
            suggested_payout: estimatedPayout,
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// ---------------------------------------------------------------------
// 2. SELLER ENDPOINTS
// ---------------------------------------------------------------------

// Create a new scrap listing
app.post('/api/seller/listings', async (req, res) => {
    try {
        const {
            seller_id = 1,
            category_id,
            title,
            description,
            estimated_weight,
            asking_price,
            longitude = 77.5946,
            latitude = 12.9716,
            landmark = 'Near Metro Pillar 42',
            gate_instructions = 'Flat 204, 2nd Floor',
        } = req.body;

        const query = `
      INSERT INTO listings (
        seller_id, category_id, title, description,
        estimated_weight, asking_price, location, landmark, gate_instructions
      )
      VALUES ($1, $2, $3, $4, $5, $6, ST_SetSRID(ST_MakePoint($7, $8), 4326), $9, $10)
      RETURNING *;
    `;

        const values = [
            seller_id,
            category_id,
            title,
            description,
            estimated_weight,
            asking_price,
            longitude,
            latitude,
            landmark,
            gate_instructions,
        ];

        const { rows } = await pool.query(query, values);
        res.status(201).json({ success: true, listing: rows[0] });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// ---------------------------------------------------------------------
// 3. BUYER ENDPOINTS
// ---------------------------------------------------------------------

// Find nearby scrap listings (Geospatial search using PostGIS)
app.get('/api/buyer/nearby-listings', async (req, res) => {
    try {
        const { lng = 77.5900, lat = 12.9700, radius = 15000 } = req.query;

        const query = `
      SELECT 
        l.id, l.title, l.description, l.estimated_weight, l.asking_price, l.status,
        l.landmark, l.gate_instructions,
        c.name AS category_name, c.standard_price_per_kg,
        u.name AS seller_name,
        ST_X(l.location::geometry) AS longitude,
        ST_Y(l.location::geometry) AS latitude,
        ROUND(ST_Distance(l.location, ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography)::numeric, 0) AS distance_meters
      FROM listings l
      JOIN categories c ON l.category_id = c.id
      JOIN users u ON l.seller_id = u.id
      WHERE l.status = 'open'
        AND ST_DWithin(l.location, ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography, $3)
      ORDER BY distance_meters ASC;
    `;

        const { rows } = await pool.query(query, [lng, lat, radius]);
        res.json({ success: true, count: rows.length, listings: rows });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Buyer accepts/schedules pickup (Generates 4-digit verification OTP)
app.post('/api/buyer/schedule-pickup', async (req, res) => {
    try {
        const { listing_id, buyer_id = 2 } = req.body;
        const otpCode = Math.floor(1000 + Math.random() * 9000).toString();

        const insertOrder = `
      INSERT INTO orders (listing_id, buyer_id, otp_code)
      VALUES ($1, $2, $3)
      RETURNING *;
    `;

        const { rows } = await pool.query(insertOrder, [listing_id, buyer_id, otpCode]);
        await pool.query("UPDATE listings SET status = 'matched' WHERE id = $1", [listing_id]);

        res.status(201).json({
            success: true,
            message: 'Pickup scheduled. Direct navigation and OTP issued.',
            order: rows[0],
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Final Doorstep Verification: Scale Photo OCR + Tare Deduction + Grade Adjustment + OTP
app.post('/api/buyer/complete-pickup', async (req, res) => {
    const client = await pool.connect();
    try {
        const {
            order_id,
            otp_code,
            gross_weight,
            tare_type = 'none',
            custom_tare = 0,
            scale_image_base64,
            adjusted_category_id,
            adjustment_reason,
        } = req.body;

        await client.query('BEGIN');

        const orderRes = await client.query(
            `SELECT o.*, l.category_id AS original_cat_id 
       FROM orders o 
       JOIN listings l ON o.listing_id = l.id 
       WHERE o.id = $1 FOR UPDATE`,
            [order_id]
        );

        if (orderRes.rows.length === 0) {
            await client.query('ROLLBACK');
            return res.status(404).json({ error: 'Order not found' });
        }

        const order = orderRes.rows[0];

        // OTP Verification
        if (order.otp_code !== otp_code) {
            await client.query('ROLLBACK');
            return res.status(400).json({ error: 'Invalid verification OTP provided by seller' });
        }

        // Tare Deduction
        let tareWeight = 0;
        if (tare_type === 'gunny_sack') tareWeight = 0.5;
        else if (tare_type === 'plastic_crate') tareWeight = 1.5;
        else if (tare_type === 'custom') tareWeight = parseFloat(custom_tare) || 0;

        const netWeight = Math.max(0, parseFloat((gross_weight - tareWeight).toFixed(2)));

        // AI Scale Verification
        let aiCheck = { status: 'unreadable_fallback', ai_weight: null, notes: 'No scale photo uploaded' };
        if (scale_image_base64) {
            const cleanImg = scale_image_base64.replace(/^data:image\/\w+;base64,/, '');
            aiCheck = await verifyScaleReading(cleanImg, gross_weight);
        }

        // Material Grade & Price Calculation
        const finalCatId = adjusted_category_id || order.original_cat_id;
        const catRes = await client.query('SELECT name, standard_price_per_kg FROM categories WHERE id = $1', [
            finalCatId,
        ]);
        const ratePerKg = parseFloat(catRes.rows[0].standard_price_per_kg);
        const finalPayout = parseFloat((netWeight * ratePerKg).toFixed(2));

        // Update Order & Listing
        await client.query(
            `UPDATE orders 
       SET gross_weight = $1, tare_deduction = $2, actual_weight = $3,
           final_amount = $4, ai_detected_weight = $5, scale_photo_status = $6,
           original_category_id = $7, adjusted_category_id = $8, category_adjusted_reason = $9,
           payment_status = 'completed', status = 'picked_up'
       WHERE id = $10`,
            [
                gross_weight,
                tareWeight,
                netWeight,
                finalPayout,
                aiCheck.ai_weight,
                aiCheck.status,
                order.original_cat_id,
                finalCatId,
                adjustment_reason || null,
                order_id,
            ]
        );

        await client.query("UPDATE listings SET status = 'completed' WHERE id = $1", [order.listing_id]);
        await client.query('COMMIT');

        res.json({
            success: true,
            summary: {
                category_name: catRes.rows[0].name,
                gross_weight_kg: gross_weight,
                tare_deducted_kg: tareWeight,
                billable_net_weight_kg: netWeight,
                rate_per_kg: ratePerKg,
                final_payout_inr: finalPayout,
                scale_verification: aiCheck.status,
                verification_notes: aiCheck.notes,
            },
        });
    } catch (err) {
        await client.query('ROLLBACK');
        res.status(500).json({ error: err.message });
    } finally {
        client.release();
    }
});

